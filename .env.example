# API unica de Calma. No agregues /api/internal/bot al final.
CALMA_API_URL=https://tu-backend.vercel.app
BOT_SERVICE_TOKEN=

# Telegram y Gemini.
TELEGRAM_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Afip SDK / ARCA.
AFIP_ACCESS_TOKEN=
AFIP_CUIT=
AFIP_PUNTO_VENTA=
AFIP_CERT_PATH=/run/arca/cert.crt
AFIP_KEY_PATH=/run/arca/private.key
ARCA_PRODUCTION=false

# Datos impresos en el PDF local.
EMISOR_NOMBRE=Calma
EMISOR_DOMICILIO=

# Operacion del worker.
WORKER_ID=calma-bot-homelab
DATA_DIR=/data
FISCAL_POLL_SECONDS=10
EVENT_POLL_SECONDS=10
HEARTBEAT_SECONDS=30
LOG_LEVEL=INFO

# Solo Compose: directorio del host con cert.crt y private.key (chmod 600).
ARCA_SECRETS_DIR=/home/nicolas/.config/calma/arca
